generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  STUDENT
  PROFESSOR
  ADMIN
}

enum SubmissionType {
  QUIZ
  CODING
  CHALLENGE
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  COMPLETED
  FAILED
}

enum MissionStatus {
  ACTIVE
  UPCOMING
  COMPLETED
}

enum Language {
  C
  CPP
  PYTHON
}

enum CosmeticType {
  AVATAR_FRAME
  PROFILE_BANNER
  PROFILE_THEME
  TITLE
}

enum ActivityEventType {
  APP_OPEN
  MISSIONS_VIEW
  MISSION_CLAIM
  CODELAB_START
  STREAK_LOST
  BADGE_UNLOCK
  HINT_PURCHASE
  COIN_TRANSACTION
}

model Role {
  id    Int      @id @default(autoincrement())
  name  RoleType @unique
  users User[]
}

model User {
  id                       Int                         @id @default(autoincrement())
  email                    String                      @unique
  password                 String
  passwordResetToken       String?                     @unique
  passwordResetExpires     DateTime?
  firstName                String
  lastName                 String
  avatarUrl                String?
  title                    String?
  bio                      String?
  xp                       Int                         @default(0)
  level                    Int                         @default(1)
  streak                   Int                         @default(0)
  wbcCoins                 Int                         @default(0)
  lastLoginAt              DateTime?
  roleId                   Int
  role                     Role                        @relation(fields: [roleId], references: [id])
  lessonsCreated           Lesson[]                    @relation("LessonAuthor")
  quizSubmissions          Submission[]                @relation("UserSubmissions")
  xpEvents                 XPEvent[]
  badges                   BadgeAssignment[]
  badgeUnlocks             BadgeUnlock[]
  friendships              Friendship[]                @relation("FriendUser")
  friendOf                 Friendship[]                @relation("FriendTarget")
  challengesSent           Challenge[]                 @relation("ChallengerRelation")
  challengesRecv           Challenge[]                 @relation("OpponentRelation")
  missionEntries           MissionParticipant[]
  reports                  ProfessorReport[]
  missionsCreated          WeeklyMission[]
  leaderboardEntry         LeaderboardEntry?
  leaderboardSeasonResults LeaderboardSeasonResult[]
  leaderboardSeasonSnapshots LeaderboardSeasonSnapshot[]
  contentApprovalsSent     ContentApproval[]           @relation("ContentApprovalProfessor")
  contentApprovalsReviewed ContentApproval[]           @relation("ContentApprovalAdmin")
  messagesSent             Message[]                   @relation("MessageSender")
  messagesReceived         Message[]                   @relation("MessageReceiver")
  chatParticipations       ConversationParticipant[]   @relation("ChatParticipant")
  chatMessagesSent         ChatMessage[]               @relation("ChatMessageSender")
  supportTickets           SupportTicket[]             @relation("SupportTicketUser")
  supportTicketsAssigned   SupportTicket[]             @relation("SupportTicketAdmin")
  supportTicketReplies     SupportTicketReply[]        @relation("SupportTicketReplyUser")
  classesCreated           Class[]                     @relation("ClassProfessor")
  classMemberships         ClassMember[]               @relation("ClassStudent")
  announcementsCreated     ClassAnnouncement[]         @relation("AnnouncementProfessor")
  assignmentsCreated       ClassAssignment[]           @relation("AssignmentProfessor")
  assignmentsReviewed      ClassAssignment[]           @relation("AssignmentAdmin")
  assignmentSubmissions    ClassAssignmentSubmission[] @relation("AssignmentSubmissionStudent")
  lessonReads              LessonRead[]                @relation("UserLessonReads")
  cosmeticOwnerships       CosmeticOwnership[]
  cosmeticEquips           CosmeticEquip[]
  activityEvents           ActivityEvent[]
  referralInvitesSent      ReferralInvite[]            @relation("ReferralInviter")
  referralInviteAcceptedAs ReferralInvite?             @relation("ReferralAcceptedUser")
  bossCompletions          BossCompletion[]
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
}

model BossCompletion {
  id         Int      @id @default(autoincrement())
  userId     Int
  moduleSlug String
  passedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, moduleSlug])
  @@index([moduleSlug])
  @@index([userId, passedAt])
}

model ActivityEvent {
  id        Int               @id @default(autoincrement())
  userId    Int
  type      ActivityEventType
  codingId  Int?
  quizId    Int?
  missionId Int?
  metadata  Json?
  createdAt DateTime          @default(now())

  user      User              @relation(fields: [userId], references: [id])

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([codingId, createdAt])
}

model ReferralInvite {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  inviterId      Int
  inviteeEmail   String?
  createdAt      DateTime @default(now())
  acceptedAt     DateTime?
  acceptedUserId Int?     @unique

  inviter        User     @relation("ReferralInviter", fields: [inviterId], references: [id])
  acceptedUser   User?    @relation("ReferralAcceptedUser", fields: [acceptedUserId], references: [id])

  @@index([inviterId, createdAt])
  @@index([acceptedAt])
}

model CosmeticItem {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  type        CosmeticType
  name        String
  description String
  priceCoins  Int          @default(0)
  rarity      String?
  metadata    Json?
  createdAt   DateTime     @default(now())

  ownerships  CosmeticOwnership[]
  equips      CosmeticEquip[]
}

model CosmeticOwnership {
  id          Int          @id @default(autoincrement())
  userId      Int
  cosmeticId  Int
  purchasedAt DateTime     @default(now())

  user     User         @relation(fields: [userId], references: [id])
  cosmetic CosmeticItem @relation(fields: [cosmeticId], references: [id])

  @@unique([userId, cosmeticId])
}

model CosmeticEquip {
  id         Int          @id @default(autoincrement())
  userId     Int
  type       CosmeticType
  cosmeticId Int?
  equippedAt DateTime     @default(now())

  user     User          @relation(fields: [userId], references: [id])
  cosmetic CosmeticItem? @relation(fields: [cosmeticId], references: [id])

  @@unique([userId, type])
}

model Lesson {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  content     String
  difficulty  String
  tags        Json
  authorId    Int
  status      String           @default("DRAFT")
  author      User             @relation("LessonAuthor", fields: [authorId], references: [id])
  quizzes     Quiz[]
  codingTasks CodingExercise[]
  reads       LessonRead[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model LessonRead {
  id        Int      @id @default(autoincrement())
  userId    Int
  lessonId  Int
  readAt    DateTime @default(now())
  user      User     @relation("UserLessonReads", fields: [userId], references: [id])
  lesson    Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model Quiz {
  id          Int            @id @default(autoincrement())
  lessonId    Int
  title       String
  description String
  timeLimit   Int
  status      String         @default("DRAFT")
  questions   QuizQuestion[]
  lesson      Lesson         @relation(fields: [lessonId], references: [id])
  submissions Submission[]
}

model QuizQuestion {
  id          Int    @id @default(autoincrement())
  quizId      Int
  prompt      String
  type        String
  options     Json
  answerKey   String
  explanation String
  quiz        Quiz   @relation(fields: [quizId], references: [id])
}

model CodingExercise {
  id             Int             @id @default(autoincrement())
  lessonId       Int
  title          String
  prompt         String
  starterCode    String
  difficulty     String
  language       Language
  category       String? // Category for challenges (Algorithms, Data Structures, Frontend, Database, Debugging)
  inputSpec      String?
  outputSpec     String?
  testCases      Json? // Array of test cases: [{input: string, output: string, stdin?: string}]
  hint           String? // Hint personalizat pentru problemă (în română)
  status         String          @default("DRAFT")
  lesson         Lesson          @relation(fields: [lessonId], references: [id])
  submissions    Submission[]
  challenges     Challenge[]
  weeklyMissions WeeklyMission[] @relation("WeeklyMissionCodingExercise")
}

model Submission {
  id            Int             @id @default(autoincrement())
  userId        Int
  quizId        Int?
  codingId      Int?
  type          SubmissionType
  sourceCode    String?
  answers       Json?
  score         Float
  maxScore      Float
  feedback      String
  explanation   String?
  runtimeStdout String?
  runtimeStderr String?
  createdAt     DateTime        @default(now())
  user          User            @relation("UserSubmissions", fields: [userId], references: [id])
  coding        CodingExercise? @relation(fields: [codingId], references: [id])
  quiz          Quiz?           @relation(fields: [quizId], references: [id])
}

model XPEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  delta     Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Badge {
  id          Int               @id @default(autoincrement())
  code        String            @unique
  name        String
  description String
  threshold   Int
  category    String            @default("MISC") // CODELAB, CONSISTENCY, SOCIAL, CHALLENGES, SEASONAL
  tier        Int               @default(1) // 1..20 within category
  icon        String?           // emoji or icon key
  rarity      String?           // COMMON, RARE, EPIC, LEGENDARY
  animation   String?           // shine, confetti, sparkle, etc.
  criteria    String?           // machine-readable criteria key
  assignments BadgeAssignment[]
  unlocks     BadgeUnlock[]
}

model BadgeAssignment {
  id        Int      @id @default(autoincrement())
  badgeId   Int
  userId    Int
  awardedAt DateTime @default(now())
  badge     Badge    @relation(fields: [badgeId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([badgeId, userId])
}

model BadgeUnlock {
  id        Int      @id @default(autoincrement())
  userId    Int
  badgeId   Int
  createdAt DateTime @default(now())
  seenAt    DateTime?

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model LeaderboardEntry {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  xp              Int
  rank            Int
  periodStartDate DateTime  @default(now()) // Data de început a perioadei curente (30 de zile)
  updatedAt       DateTime  @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model LeaderboardSeason {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  results   LeaderboardSeasonResult[]
  snapshots LeaderboardSeasonSnapshot[]

  @@unique([startDate, endDate])
}

model LeaderboardSeasonResult {
  id        Int      @id @default(autoincrement())
  seasonId  Int
  userId    Int
  rank      Int
  xp        Int
  createdAt DateTime @default(now())

  season LeaderboardSeason @relation(fields: [seasonId], references: [id])
  user   User              @relation(fields: [userId], references: [id])

  @@unique([seasonId, userId])
  @@index([userId, rank])
}

// Optional: can be populated daily later to enable "Comeback Kid" etc.
model LeaderboardSeasonSnapshot {
  id        Int      @id @default(autoincrement())
  seasonId  Int
  userId    Int
  rank      Int
  xp        Int
  takenAt   DateTime @default(now())

  season LeaderboardSeason @relation(fields: [seasonId], references: [id])
  user   User              @relation(fields: [userId], references: [id])

  @@index([seasonId, takenAt])
  @@index([userId, takenAt])
}

model Friendship {
  id            Int      @id @default(autoincrement())
  requester     Int
  addressee     Int
  status        String   @default("accepted")
  createdAt     DateTime @default(now())
  requesterUser User     @relation("FriendUser", fields: [requester], references: [id])
  addresseeUser User     @relation("FriendTarget", fields: [addressee], references: [id])

  @@unique([requester, addressee], name: "requester_addressee")
}

model Challenge {
  id               Int             @id @default(autoincrement())
  challengerId     Int
  opponentId       Int
  codingExerciseId Int
  status           ChallengeStatus @default(PENDING)
  challengerScore  Float           @default(0)
  opponentScore    Float           @default(0)
  bonusXP          Int             @default(0)
  acceptedAt       DateTime?
  completedAt      DateTime?
  winnerId         Int?
  createdAt        DateTime        @default(now())
  challenger       User            @relation("ChallengerRelation", fields: [challengerId], references: [id])
  opponent         User            @relation("OpponentRelation", fields: [opponentId], references: [id])
  codingExercise   CodingExercise  @relation(fields: [codingExerciseId], references: [id])
}

model WeeklyMission {
  id               Int                  @id @default(autoincrement())
  title            String
  description      String
  goalType         String
  goalValue        Int
  rewardXP         Int
  status           MissionStatus        @default(ACTIVE)
  startDate        DateTime
  endDate          DateTime
  creatorId        Int
  creator          User                 @relation(fields: [creatorId], references: [id])
  codingExerciseId Int?
  codingExercise   CodingExercise?      @relation("WeeklyMissionCodingExercise", fields: [codingExerciseId], references: [id])
  participants     MissionParticipant[]
}

model MissionParticipant {
  id        Int           @id @default(autoincrement())
  missionId Int
  userId    Int
  progress  Int           @default(0)
  completed Boolean       @default(false)
  completedAt DateTime?
  rewardClaimed Boolean   @default(false)
  rewardClaimedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  mission   WeeklyMission @relation(fields: [missionId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@unique([missionId, userId], name: "missionId_userId")
}

model ProfessorReport {
  id          Int      @id @default(autoincrement())
  professorId Int
  payload     Json
  createdAt   DateTime @default(now())
  professor   User     @relation(fields: [professorId], references: [id])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISIONS_REQUESTED
}

enum ContentType {
  LESSON
  QUIZ
  CODING_EXERCISE
}

model ContentApproval {
  id             Int            @id @default(autoincrement())
  contentType    ContentType
  contentId      Int
  professorId    Int
  adminId        Int?
  status         ApprovalStatus @default(PENDING)
  adminNotes     String?
  professorNotes String?
  createdAt      DateTime       @default(now())
  reviewedAt     DateTime?
  professor      User           @relation("ContentApprovalProfessor", fields: [professorId], references: [id])
  admin          User?          @relation("ContentApprovalAdmin", fields: [adminId], references: [id])
}

enum MessageStatus {
  SENT
  READ
  ARCHIVED
}

model Message {
  id         Int           @id @default(autoincrement())
  senderId   Int
  receiverId Int
  subject    String
  content    String
  status     MessageStatus @default(SENT)
  isRead     Boolean       @default(false)
  readAt     DateTime?
  createdAt  DateTime      @default(now())
  sender     User          @relation("MessageSender", fields: [senderId], references: [id])
  receiver   User          @relation("MessageReceiver", fields: [receiverId], references: [id])
}

enum ConversationType {
  DIRECT
  GROUP
  SUPPORT
}

model Conversation {
  id           Int                       @id @default(autoincrement())
  type         ConversationType          @default(DIRECT)
  name         String? // For group chats
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     ChatMessage[]
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         Int
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation("ChatParticipant", fields: [userId], references: [id])

  @@unique([conversationId, userId], name: "conversation_user")
}

model ChatMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("ChatMessageSender", fields: [senderId], references: [id])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id          Int                   @id @default(autoincrement())
  userId      Int
  adminId     Int?
  subject     String
  description String
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  category    String
  resolution  String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  resolvedAt  DateTime?
  user        User                  @relation("SupportTicketUser", fields: [userId], references: [id])
  admin       User?                 @relation("SupportTicketAdmin", fields: [adminId], references: [id])
  replies     SupportTicketReply[]
}

model SupportTicketReply {
  id         Int           @id @default(autoincrement())
  ticketId   Int
  userId     Int
  content    String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  user       User          @relation("SupportTicketReplyUser", fields: [userId], references: [id])
}

enum AssignmentType {
  PROBLEM
  HOMEWORK
  MATERIAL
}

enum AssignmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
}

model Class {
  id             Int                 @id @default(autoincrement())
  name           String
  description    String?
  professorId    Int
  invitationCode String              @unique
  isActive       Boolean             @default(true)
  usesRoadmap    Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  professor      User                @relation("ClassProfessor", fields: [professorId], references: [id])
  members        ClassMember[]
  announcements  ClassAnnouncement[]
  assignments    ClassAssignment[]
}

model ClassMember {
  id        Int      @id @default(autoincrement())
  classId   Int
  studentId Int
  joinedAt  DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])
  student   User     @relation("ClassStudent", fields: [studentId], references: [id])

  @@unique([classId, studentId], name: "classId_studentId")
}

model ClassAnnouncement {
  id          Int      @id @default(autoincrement())
  classId     Int
  professorId Int
  title       String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  class       Class    @relation(fields: [classId], references: [id])
  professor   User     @relation("AnnouncementProfessor", fields: [professorId], references: [id])
}

model ClassAssignment {
  id          Int                         @id @default(autoincrement())
  classId     Int
  professorId Int
  title       String
  description String
  type        AssignmentType
  status      AssignmentStatus            @default(DRAFT)
  difficulty  String
  contentId   Int? // Reference to Lesson, Quiz, or CodingExercise
  contentType String? // 'LESSON', 'QUIZ', 'CODING_EXERCISE'
  dueDate     DateTime?
  adminId     Int?
  adminNotes  String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  approvedAt  DateTime?
  class       Class                       @relation(fields: [classId], references: [id])
  professor   User                        @relation("AssignmentProfessor", fields: [professorId], references: [id])
  admin       User?                       @relation("AssignmentAdmin", fields: [adminId], references: [id])
  submissions ClassAssignmentSubmission[]
}

model ClassAssignmentSubmission {
  id           Int             @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  submissionId Int? // Reference to Submission (quiz or coding)
  score        Float?
  maxScore     Float?
  submittedAt  DateTime        @default(now())
  assignment   ClassAssignment @relation(fields: [assignmentId], references: [id])
  student      User            @relation("AssignmentSubmissionStudent", fields: [studentId], references: [id])
}
